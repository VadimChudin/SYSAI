{
	"version": 1,
	"inference": {
		"run": {
			"detectorVersion": 4,
			"framework": "fastapi",
			"workspacePath": null
		}
	},
	"ports": {
		"preview": 8000,
		"additional": {}
	},
	"services": [],
	"scripts": {
		"setup": {
			"enabled": true,
			"command": "export UV_CACHE_DIR=\"$PWD/.hoplite/cache/uv\"; uv venv --allow-existing .venv && uv pip install --python .venv/bin/python -r requirements-dev.txt"
		},
		"run": {
			"enabled": true,
			"command": "PATH=\"$PWD/.venv/bin:$PATH\" uvicorn app.main:app --reload --host 0.0.0.0 --port 8000"
		},
		"archive": {
			"enabled": true,
			"command": null
		}
	},
	"mcpServers": []
}
